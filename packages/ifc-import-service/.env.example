FILEIMPORT_QUEUE_POSTGRES_URL=postgresql://speckle:speckle@127.0.0.1:5432/speckle
# 单次任务最大超时时间（分钟），默认 30 分钟（1800 秒），可通过此项放宽（例如 60 分钟 = 3600 秒）
FILE_IMPORT_TIME_LIMIT_MIN=60

# ---- 上传阶段调优 ----
# 上传阶段的主要成本是 HTTP 往返次数：specklepy 对每个批次都会先发一次
# /api/diff 存在性检查，再发一次 /objects 上传。批次太小会把大模型切成数千个
# 批次，导致上传极慢。服务端单请求上限为 MAX_OBJECT_UPLOAD_FILE_SIZE_MB（默认 100MB）。
# 单个批次的最大未压缩体积（MB），默认 8.0
# IFC_UPLOAD_BATCH_MB=8.0
# 单个批次的最大对象数，默认 2000
# IFC_UPLOAD_BATCH_LENGTH=2000
# 发送队列长度（在途批次数的内存水位），默认 3
# IFC_UPLOAD_BATCH_BUFFER=3
# 上传线程数，默认 4
# IFC_UPLOAD_THREADS=4
