# Local frontend-2 dev server that talks to a remote Speckle server through a local
# reverse proxy (`yarn dev:remote` -> tools/dev-remote-proxy.mjs).
#
# Topology:
#   browser -> http://127.0.0.1:8081  (dev proxy, same origin for app + API)
#                 |- /graphql,/api/**,/auth/**,... -> http://47.100.77.97:64482
#                 '- everything else               -> http://127.0.0.1:3001 (nuxt dev)
#
# For plain local development against a locally running server use `.env` + `yarn dev`.

HOST=127.0.0.1
# Internal port of the `nuxt dev` process. Browsers must use DEV_PROXY_PORT instead.
PORT=3001

##########################################################
# Local dev proxy settings (read by tools/dev-remote-proxy.mjs)
##########################################################
DEV_PROXY_HOST=127.0.0.1
# Public port the browser talks to
DEV_PROXY_PORT=8081
# Remote Speckle server to proxy backend traffic to
DEV_PROXY_TARGET=http://47.100.77.97:64482
# Local `nuxt dev` server that serves the app itself
DEV_PROXY_FRONTEND=http://127.0.0.1:3001
# Backend path prefixes forwarded to DEV_PROXY_TARGET (HTTP + WebSocket), comma separated
# DEV_PROXY_BACKEND_PATHS=/graphql,/api,/auth,/objects,/preview,/static,/explorer,/liveness,/readiness
# Paths that always stay on the local frontend, even if they match a backend prefix
# DEV_PROXY_LOCAL_PATHS=/api/status
# Set to 1 to log every single proxied request
# DEV_PROXY_VERBOSE=1

NUXT_PUBLIC_LOG_LEVEL=debug
NUXT_PUBLIC_LOG_PRETTY=true

# Whether to emit extra properties (bindings) that would be sent to seq to the console in CSR
NUXT_PUBLIC_LOG_CSR_EMIT_PROPS=false

# Browser facing API origin. Points at the dev proxy, so app + API share one origin
# (cookies, redirects, uploads and WebSockets behave like they do behind the nginx ingress).
NUXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8081
# Server side rendering talks to the remote backend directly
NUXT_PUBLIC_BACKEND_API_ORIGIN=http://47.100.77.97:64482

NUXT_PUBLIC_BASE_URL=http://127.0.0.1:8081

NUXT_PUBLIC_MIXPANEL_TOKEN_ID=acd87c5a50b56df91a795e999812a3a4
NUXT_PUBLIC_MIXPANEL_API_HOST=

NUXT_PUBLIC_SERVER_NAME=local

# NUXT_REDIS_URL=redis://127.0.0.1:6379

# Set to true for extra logging related to viewer
NUXT_PUBLIC_VIEWER_DEBUG=false

# RUM monitoring
NUXT_PUBLIC_DATADOG_APP_ID=
NUXT_PUBLIC_DATADOG_CLIENT_TOKEN=
NUXT_PUBLIC_DATADOG_SITE=
NUXT_PUBLIC_DATADOG_SERVICE=
NUXT_PUBLIC_DATADOG_ENV=

# Debug core web vitals in the console
NUXT_PUBLIC_DEBUG_CORE_WEB_VITALS=false

# Enable Speckle Automate functionality
NUXT_PUBLIC_FF_AUTOMATE_MODULE_ENABLED=false

# Intercom App ID
NUXT_PUBLIC_INTERCOM_APP_ID=

# Enable Autodesk construction cloud integration
NUXT_PUBLIC_FF_ACC_INTEGRATION_ENABLED=false

# Local or remote URL for dashboards
NUXT_PUBLIC_DASHBOARDS_ORIGIN=http://localhost:8083

#File imports
NUXT_PUBLIC_FF_LARGE_FILE_IMPORTS_ENABLED=true
NUXT_PUBLIC_FF_NEXT_GEN_FILE_IMPORTER_ENABLED=true
NUXT_PUBLIC_FF_RHINO_FILE_IMPORTER_ENABLED=true
NUXT_PUBLIC_KK_FILE_VIEW_URL=https://kkfileview.siruijie.com.cn
